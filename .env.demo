# ---------------------------------------------------------------------------
# Foyer CRM demo environment
# Used by "npm run demo" and "npm run demo:seed". Values here override .env.
# Everything in this file is fake and safe to share.
# ---------------------------------------------------------------------------
APP_URL=http://localhost:3001
# Separate build folder so the demo can run next to `npm run dev`.
NEXT_DIST_DIR=.next-demo

# Separate database so demo data never mixes with real client data.
DATABASE_URL=postgres://foyer:foyer@localhost:5432/foyer_demo

# Demo login
ADMIN_EMAIL=demo@foyer.demo
# Password: FoyerDemo1
ADMIN_PASSWORD_HASH=scrypt:16384:8:1:EMd4kMMxqw52zpu1ZsZMBA:OWYYATsmM4NTQ29uuzPmip57iUu6V5QXZZe3XJ6vobhxAoq1sBE3_BoN_8hBztH8dYr_nWu32eUh6JvhKQ7KiA
AUTH_SECRET=qqkv9SM3YNjPPNLR4cJnyboEdJSTs6LRjVl9rMVn3XuxcGaMY7kmDGvWEta11xae

# Demo mode: show the email and WhatsApp composers and simulate sending, so
# replies (and AI drafts) can be demonstrated without live integrations.
FOYER_DEMO=true

# Integrations are intentionally blank: the demo ships with seeded
# conversations instead of a live Gmail or WhatsApp connection.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_PUBSUB_TOPIC=
GMAIL_PUSH_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
CRON_SECRET=demo-cron-secret
ANTHROPIC_API_KEY=
# Shows the "Draft with AI" button with pre-written drafts for the demo clients.
AI_DRAFT_DEMO=true
