# ---------------------------------------------------------------------------
# Foyer CRM environment
# Copy this file to .env (local) or add each value in the Vercel project settings.
# ---------------------------------------------------------------------------

# Public URL of the deployment, without a trailing slash.
# Used to build the Google OAuth redirect and the webhook URLs shown in Settings.
APP_URL=http://localhost:3000

# Postgres connection string (Neon, Supabase, Railway or any Postgres 14+).
# For Neon use the pooled connection string.
DATABASE_URL=postgres://foyer:foyer@127.0.0.1:5432/foyer

# ---- Admin account (single user) -------------------------------------------
# Generate the hash with:  npm run auth:hash -- "your password"
# The output looks like scrypt:16384:8:1:<salt>:<hash> and is safe to paste as is.
ADMIN_EMAIL=agent@example.com
ADMIN_PASSWORD_HASH=
# Optional extra sign-ins (e.g. a colleague or a test user). They share the same
# CRM data. Comma-separated email:hash pairs; generate an entry with:
#   npm run auth:user -- "person@example.com" "their password"
ADDITIONAL_USERS=

# Random secret used to sign the session cookie and to encrypt stored OAuth
# tokens. Generate with:  openssl rand -base64 48
AUTH_SECRET=

# ---- Gmail (Google OAuth) ---------------------------------------------------
# Google Cloud console > APIs & Services > Credentials > OAuth client (Web).
# Authorised redirect URI must be:  {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Google Cloud Pub/Sub topic for instant Gmail push notifications,
# e.g. projects/my-project/topics/gmail-crm. Leave blank to rely on polling.
GMAIL_PUBSUB_TOPIC=
# Shared token placed in the Pub/Sub push endpoint URL:
#   {APP_URL}/api/webhooks/gmail?token={GMAIL_PUSH_TOKEN}
GMAIL_PUSH_TOKEN=

# ---- WhatsApp Business Cloud API (Meta) -------------------------------------
# Meta for Developers > your app > WhatsApp > API Setup.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Permanent System User access token with whatsapp_business_messaging and
# whatsapp_business_management permissions.
WHATSAPP_ACCESS_TOKEN=
# App secret (App settings > Basic) used to verify webhook signatures.
WHATSAPP_APP_SECRET=
# Any random string; enter the same value when configuring the webhook in Meta.
WHATSAPP_VERIFY_TOKEN=
# Graph API version to call.
WHATSAPP_API_VERSION=v21.0

# ---- Scheduled sync -----------------------------------------------------------
# Vercel sends this automatically as a bearer token for cron invocations.
# Any external scheduler can call GET {APP_URL}/api/cron/sync with
# header  Authorization: Bearer {CRON_SECRET}
CRON_SECRET=

# ---- AI reply drafts (Anthropic) ----------------------------------------------
# Optional. When set, a "Draft with AI" button appears in the reply composer and
# Claude drafts a reply from the client record, linked properties and the thread.
# Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional override of the model used for drafts (default: claude-opus-5).
ANTHROPIC_MODEL=
# Set to true to show the Draft with AI button with canned demo drafts (no API calls).
AI_DRAFT_DEMO=
# Set to true to show the reply composers without Gmail/WhatsApp and record
# sent messages without calling the external APIs. Only for demos.
FOYER_DEMO=
